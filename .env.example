# ============================================================
# Charvak IT Consulting — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. NEVER paste real secrets in chat.
# ============================================================

# --- Database (Postgres / Render) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Flask / Session ---
SECRET_KEY=generate-with-python-secrets-token-hex-32
FLASK_ENV=production

# --- Email: Brevo (primary) ---
BREVO_API_KEY=xkeysib-REPLACE_ME
BREVO_SENDER_EMAIL=hr@charvakit.com
BREVO_SENDER_NAME=Charvak IT Consulting

# --- Email: SendGrid (fallback) ---
SENDGRID_API_KEY=SG.REPLACE_ME

# --- Cron / Scheduled Jobs ---
CRON_SECRET=generate-with-python-secrets-token-hex-32
CRON_HEADER_NAME=X-Cron-Secret

# --- External APIs ---
TECHMAP_API_KEY=REPLACE_ME

# --- Application URLs ---
BASE_URL=https://www.charvakit.com
VERIFY_BASE_URL=https://www.charvakit.com/verify

# --- Feature Flags ---
ENABLE_INTEGRITY_TRACKING=true
ENABLE_TEST_CERT_FILTER=true